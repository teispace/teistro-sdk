{
  "name": "@teistro/sdk",
  "version": "1.0.0-rc.1",
  "description": "Teistro SDK for Node: the addon over the C ABI with its generated types, the catalogue's tables, the result-blob decoders and the ergonomic layer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teispace/teistro-sdk.git",
    "directory": "bindings/node"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#native": "./lib/addon.js"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./catalogue": {
      "types": "./lib/catalogue.d.ts",
      "default": "./lib/catalogue.js"
    },
    "./messages": {
      "types": "./lib/messages.d.ts",
      "default": "./lib/messages.js"
    },
    "./types": {
      "types": "./lib/types.d.ts"
    },
    "./blob": {
      "types": "./lib/blob.d.ts",
      "default": "./lib/blob.js"
    }
  },
  "files": [
    "lib/",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "optionalDependencies": {
    "@teistro/sdk-linux-x64": "1.0.0-rc.1",
    "@teistro/sdk-linux-arm64": "1.0.0-rc.1",
    "@teistro/sdk-darwin-arm64": "1.0.0-rc.1",
    "@teistro/sdk-darwin-x64": "1.0.0-rc.1",
    "@teistro/sdk-win32-x64": "1.0.0-rc.1",
    "@teistro/sdk-win32-arm64": "1.0.0-rc.1",
    "@teistro/sdk-linux-x64-musl": "1.0.0-rc.1",
    "@teistro/sdk-linux-arm64-musl": "1.0.0-rc.1"
  }
}
