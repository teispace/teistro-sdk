      "name": "TspStatus",
      "repr": "i32",
      "doc": "The status of every call. `0` is success; everything else names the\nfailure, with the same numbers in every binding.",
      "values": [
        {
          "name": "Ok",
          "value": 0,
          "doc": "Success."
        },
        {
          "name": "InvalidArgument",
          "value": -1,
          "doc": "A null pointer, a wrong `struct_size`, or an enum index outside its\nrange."
        },
        {
          "name": "DepthOutOfRange",
          "value": -2,
          "doc": "`dasha_depth` outside `1..=5`."
        },
        {
          "name": "JulianDayNotFinite",
          "value": -3,
          "doc": "The Julian Day is NaN or infinite."
        },
        {
          "name": "Provider",
          "value": -4,
          "doc": "The provider failed; `tsp_context_last_provider_code` has its code."
        },
        {
          "name": "PositionNotFinite",
          "value": -5,
          "doc": "The provider returned a non-finite longitude."
        }
      ]
    },
