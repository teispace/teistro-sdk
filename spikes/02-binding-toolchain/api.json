    {
      "name": "TspBlob",
      "doc": "A computed chart, owned by the library until `tsp_blob_free`.\n\nThe bytes follow the `TSPB` layout: a 32-byte header (magic\n`0x4250_5354`, version `1`, section count, total length), a table of\n`{id, offset, length, count}` entries, then the sections. Section `1`\nis the chart header (`jd_ut`, `ayanamsha_deg`, depth, counts), section\n`2` the nine positions as columns, section `3` the dasha rows as\ncolumns; each column section starts with a directory of column offsets\nrelative to the section start. Every multi-byte column is 8-aligned.",
      "blob": "TSPB",
      "fields": [
        {
          "name": "data",
          "ty": {
            "kind": "pointer",
            "to": {
              "kind": "scalar",
              "name": "u8"
            },
            "mutable": true
          },
          "doc": "The bytes; null when the blob is empty.",
          "meta": {}
        },
        {
          "name": "len",
          "ty": {
            "kind": "scalar",
            "name": "usize"
          },
          "doc": "The number of bytes.",
          "meta": {}
        },
        {
          "name": "cap",
          "ty": {
            "kind": "scalar",
            "name": "usize"
          },
          "doc": "The allocation's capacity, needed to free it.",
          "meta": {}
        }
      ]
    }
  ],
