{
 "weekdayName": ".input {$weekday :integer} .match $weekday 0 {{आइतबार}} 1 {{सोमबार}} 2 {{मङ्गलबार}} 3 {{बुधबार}} 4 {{बिहीबार}} 5 {{शुक्रबार}} 6 {{शनिबार}} * {{{$weekday}}}",
 "weekdayShort": ".input {$weekday :integer} .match $weekday 0 {{आइत}} 1 {{सोम}} 2 {{मङ्गल}} 3 {{बुध}} 4 {{बिही}} 5 {{शुक्र}} 6 {{शनि}} * {{{$weekday}}}",
 "lunarMonth": ".input {$masa :entity kind=masa} .input {$kind :string} .match $kind ADHIKA {{अधिक {$masa}}} KSHAYA {{क्षय {$masa}}} * {{{$masa}}}",
 "nepalSambatMonth": ".input {$month :integer} .input {$kind :string} .match $kind $month ADHIKA * {{अनला}} * 1 {{कछला}} * 2 {{थिंल्ला}} * 3 {{पोहेला}} * 4 {{सिल्ला}} * 5 {{चिल्ला}} * 6 {{चौला}} * 7 {{वछला}} * 8 {{तछला}} * 9 {{दिल्ला}} * 10 {{गुंला}} * 11 {{ञँला}} * 12 {{कौला}} * * {{{$month}}}",
 "nepalSambatHalf": ".input {$paksha :string} .match $paksha SHUKLA {{थ्व}} paksha.SHUKLA {{थ्व}} KRISHNA {{गा}} paksha.KRISHNA {{गा}} * {{{$paksha}}}",
 "nepalSambatDate": ".input {$year :integer} .input {$month :integer} .input {$kind :string} .input {$paksha :string} {{ने.सं. {$year :integer useGrouping=false} {sdk.calendar.nepalSambatMonth :msg}{sdk.calendar.nepalSambatHalf :msg}}}",
 "GREGORIAN": {
  "monthName": ".input {$month :integer} .match $month 1 {{जनवरी}} 2 {{फेब्रुअरी}} 3 {{मार्च}} 4 {{अप्रिल}} 5 {{मे}} 6 {{जुन}} 7 {{जुलाई}} 8 {{अगस्ट}} 9 {{सेप्टेम्बर}} 10 {{अक्टोबर}} 11 {{नोभेम्बर}} 12 {{डिसेम्बर}} * {{{$month}}}",
  "monthShort": "{sdk.calendar.GREGORIAN.monthName :msg}",
  "date": {
   "numeric": "{$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2}",
   "long": "{$year :integer useGrouping=false} {$monthName} {$day :integer}",
   "full": "{$weekdayName}, {$year :integer useGrouping=false} {$monthName} {$day :integer}"
  }
 },
 "JULIAN": {
  "monthName": "{sdk.calendar.GREGORIAN.monthName :msg}",
  "monthShort": "{sdk.calendar.GREGORIAN.monthShort :msg}",
  "date": {
   "numeric": "{sdk.calendar.GREGORIAN.date.numeric :msg}",
   "long": "{sdk.calendar.GREGORIAN.date.long :msg}",
   "full": "{sdk.calendar.GREGORIAN.date.full :msg}"
  }
 },
 "MIXED": {
  "monthName": "{sdk.calendar.GREGORIAN.monthName :msg}",
  "monthShort": "{sdk.calendar.GREGORIAN.monthShort :msg}",
  "date": {
   "numeric": "{sdk.calendar.GREGORIAN.date.numeric :msg}",
   "long": "{sdk.calendar.GREGORIAN.date.long :msg}",
   "full": "{sdk.calendar.GREGORIAN.date.full :msg}"
  }
 },
 "ISO_WEEK": {
  "date": {
   "numeric": "{$year :integer useGrouping=false}-W{$month :integer minimumIntegerDigits=2}-{$day :integer}",
   "long": "{$year :integer useGrouping=false} को {$month :integer} हप्ता, दिन {$day :integer}",
   "full": "{sdk.calendar.ISO_WEEK.date.long :msg}"
  }
 },
 "BIKRAM_SAMBAT": {
  "monthName": ".input {$month :integer} .match $month 1 {{बैशाख}} 2 {{जेठ}} 3 {{असार}} 4 {{साउन}} 5 {{भदौ}} 6 {{असोज}} 7 {{कात्तिक}} 8 {{मंसिर}} 9 {{पुष}} 10 {{माघ}} 11 {{फागुन}} 12 {{चैत}} * {{{$month}}}",
  "monthShort": "{sdk.calendar.BIKRAM_SAMBAT.monthName :msg}",
  "date": {
   "numeric": "{$year :integer useGrouping=false}/{$month :integer minimumIntegerDigits=2}/{$day :integer minimumIntegerDigits=2} गते",
   "long": "{$year :integer useGrouping=false} {$monthName} {$day :integer} गते",
   "full": "{$weekdayName}, {$year :integer useGrouping=false} {$monthName} {$day :integer} गते"
  }
 },
 "INDIAN_NATIONAL": {
  "monthName": ".input {$month :integer} .match $month 1 {{चैत्र}} 2 {{वैशाख}} 3 {{ज्येष्ठ}} 4 {{आषाढ}} 5 {{श्रावण}} 6 {{भाद्र}} 7 {{आश्विन}} 8 {{कार्तिक}} 9 {{अग्रहायण}} 10 {{पौष}} 11 {{माघ}} 12 {{फाल्गुन}} * {{{$month}}}",
  "monthShort": "{sdk.calendar.INDIAN_NATIONAL.monthName :msg}",
  "date": {
   "numeric": "शक {$year :integer useGrouping=false}/{$month :integer minimumIntegerDigits=2}/{$day :integer minimumIntegerDigits=2}",
   "long": "शक {$year :integer useGrouping=false} {$monthName} {$day :integer}",
   "full": "{$weekdayName}, शक {$year :integer useGrouping=false} {$monthName} {$day :integer}"
  }
 },
 "HIJRI_TABULAR": {
  "monthName": ".input {$month :integer} .match $month 1 {{Muharram}} 2 {{Safar}} 3 {{Rabiʻ I}} 4 {{Rabiʻ II}} 5 {{Jumada I}} 6 {{Jumada II}} 7 {{Rajab}} 8 {{Shaʻban}} 9 {{Ramadan}} 10 {{Shawwal}} 11 {{Dhuʻl-Qiʻdah}} 12 {{Dhuʻl-Hijjah}} * {{{$month}}}",
  "monthShort": ".input {$month :integer} .match $month 1 {{Muh.}} 2 {{Saf.}} 3 {{Rab. I}} 4 {{Rab. II}} 5 {{Jum. I}} 6 {{Jum. II}} 7 {{Raj.}} 8 {{Sha.}} 9 {{Ram.}} 10 {{Shaw.}} 11 {{Dhuʻl-Q.}} 12 {{Dhuʻl-H.}} * {{{$month}}}",
  "date": {
   "numeric": "AH {$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2}",
   "long": "AH {$year :integer useGrouping=false} {$monthName} {$day :integer}",
   "full": "AH {$year :integer useGrouping=false} {$monthName} {$day :integer}, {$weekdayName}"
  }
 },
 "TIBETAN_PHUGPA": {
  "monthName": ".input {$leap :string} .match $leap MONTH {{अधिक महिना {$month :integer}}} MONTH_AND_DAY {{अधिक महिना {$month :integer}}} * {{महिना {$month :integer}}}",
  "monthShort": ".input {$leap :string} .match $leap MONTH {{अधिक {$month :integer}}} MONTH_AND_DAY {{अधिक {$month :integer}}} * {{{$month :integer}}}",
  "date": {
   "numeric": ".input {$leap :string} .match $leap MONTH {{{$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2} (अधिक महिना)}} DAY {{{$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2} (दोहोरिएको तिथि)}} MONTH_AND_DAY {{{$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2} (अधिक महिना, दोहोरिएको तिथि)}} * {{{$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2}}}",
   "long": ".input {$leap :string} .match $leap DAY {{{$year :integer useGrouping=false} {$monthName}, तिथि {$day :integer} (दोहोरिएको)}} MONTH_AND_DAY {{{$year :integer useGrouping=false} {$monthName}, तिथि {$day :integer} (दोहोरिएको)}} * {{{$year :integer useGrouping=false} {$monthName}, तिथि {$day :integer}}}",
   "full": ".input {$leap :string} .match $leap DAY {{{$year :integer useGrouping=false} {$monthName}, तिथि {$day :integer} (दोहोरिएको), {$weekdayName}}} MONTH_AND_DAY {{{$year :integer useGrouping=false} {$monthName}, तिथि {$day :integer} (दोहोरिएको), {$weekdayName}}} * {{{$year :integer useGrouping=false} {$monthName}, तिथि {$day :integer}, {$weekdayName}}}"
  }
 },
 "time": {
  "numeric": "{$hour :integer minimumIntegerDigits=2}:{$minute :integer minimumIntegerDigits=2}",
  "long": "{$hour :integer minimumIntegerDigits=2}:{$minute :integer minimumIntegerDigits=2}:{$second :integer minimumIntegerDigits=2}",
  "numeric12": "{$dayPeriod} {$hour12 :integer}:{$minute :integer minimumIntegerDigits=2}",
  "long12": "{$dayPeriod} {$hour12 :integer}:{$minute :integer minimumIntegerDigits=2}:{$second :integer minimumIntegerDigits=2}"
 },
 "datetime": {
  "join": "{$date}, {$time}",
  "inZone": "{$at :datetime timeZone=$zone}"
 },
 "ghati": {
  "numeric": "{$ghati :integer minimumIntegerDigits=2}-{$pala :integer minimumIntegerDigits=2}",
  "long": "{$ghati :integer} घडी {$pala :integer} पला"
 },
 "duration": {
  "day": "{$n :number} दिन",
  "hour": "{$n :number} घण्टा",
  "minute": "{$n :number} मिनेट",
  "second": "{$n :number} सेकेन्ड"
 },
 "dayPeriod": {
  "am": "पूर्वाह्न",
  "pm": "अपराह्न",
  "morning": "बिहान",
  "afternoon": "दिउँसो",
  "evening": "साँझ",
  "night": "राति"
 }
}
