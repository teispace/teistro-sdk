{
  "locale": "en-Latn",
  "direction": "ltr",
  "numberingSystem": "latn",
  "grouping": [3],
  "decimal": ".",
  "group": ",",
  "fallback": [],
  "completeness": "strict",
  "contexts": {
    "gender": ["m", "f", "n"]
  },
  "termStyle": "vernacular",
  "listPatterns": {
    "and": { "pair": "{0} and {1}", "middle": "{0}, {1}", "end": "{0} and {1}" },
    "or": { "pair": "{0} or {1}", "middle": "{0}, {1}", "end": "{0} or {1}" }
  }
}
