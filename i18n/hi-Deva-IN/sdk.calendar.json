{
  "weekdayName": ".input {$weekday :integer} .match $weekday 0 {{रविवार}} 1 {{सोमवार}} 2 {{मंगलवार}} 3 {{बुधवार}} 4 {{गुरुवार}} 5 {{शुक्रवार}} 6 {{शनिवार}} * {{{$weekday}}}",
  "weekdayShort": ".input {$weekday :integer} .match $weekday 0 {{रवि}} 1 {{सोम}} 2 {{मंगल}} 3 {{बुध}} 4 {{गुरु}} 5 {{शुक्र}} 6 {{शनि}} * {{{$weekday}}}",
  "lunarMonth": ".input {$masa :entity kind=masa} .input {$kind :string} .match $kind ADHIKA {{अधिक {$masa}}} KSHAYA {{क्षय {$masa}}} * {{{$masa}}}",
  "nepalSambatMonth": ".input {$month :integer} .input {$kind :string} .match $kind $month ADHIKA * {{अनला}} * 1 {{कछला}} * 2 {{थिंल्ला}} * 3 {{पोहेला}} * 4 {{सिल्ला}} * 5 {{चिल्ला}} * 6 {{चौला}} * 7 {{वछला}} * 8 {{तछला}} * 9 {{दिल्ला}} * 10 {{गुंला}} * 11 {{ञँला}} * 12 {{कौला}} * * {{{$month}}}",
  "nepalSambatHalf": ".input {$paksha :string} .match $paksha SHUKLA {{थ्व}} paksha.SHUKLA {{थ्व}} KRISHNA {{गा}} paksha.KRISHNA {{गा}} * {{{$paksha}}}",
  "nepalSambatDate": ".input {$year :integer} .input {$month :integer} .input {$kind :string} .input {$paksha :string} {{ने.सं. {$year :integer useGrouping=false} {sdk.calendar.nepalSambatMonth :msg}{sdk.calendar.nepalSambatHalf :msg}}}",
  "parana": ".input {$fast :string} {{{$fast} का पारण}}",
  "GREGORIAN": {
    "monthName": ".input {$month :integer} .match $month 1 {{जनवरी}} 2 {{फ़रवरी}} 3 {{मार्च}} 4 {{अप्रैल}} 5 {{मई}} 6 {{जून}} 7 {{जुलाई}} 8 {{अगस्त}} 9 {{सितंबर}} 10 {{अक्टूबर}} 11 {{नवंबर}} 12 {{दिसंबर}} * {{{$month}}}",
    "monthShort": ".input {$month :integer} .match $month 1 {{जन॰}} 2 {{फ़र॰}} 3 {{मार्च}} 4 {{अप्रैल}} 5 {{मई}} 6 {{जून}} 7 {{जुल॰}} 8 {{अग॰}} 9 {{सित॰}} 10 {{अक्टू॰}} 11 {{नव॰}} 12 {{दिस॰}} * {{{$month}}}",
    "date": {
      "numeric": "{$day :integer minimumIntegerDigits=2}/{$month :integer minimumIntegerDigits=2}/{$year :integer useGrouping=false}",
      "long": "{$day :integer} {$monthName} {$year :integer useGrouping=false}",
      "full": "{$weekdayName}, {$day :integer} {$monthName} {$year :integer useGrouping=false}"
    }
  },
  "JULIAN": {
    "monthName": "{sdk.calendar.GREGORIAN.monthName :msg}",
    "monthShort": "{sdk.calendar.GREGORIAN.monthShort :msg}",
    "date": {
      "numeric": "{sdk.calendar.GREGORIAN.date.numeric :msg}",
      "long": "{sdk.calendar.GREGORIAN.date.long :msg}",
      "full": "{sdk.calendar.GREGORIAN.date.full :msg}"
    }
  },
  "MIXED": {
    "monthName": "{sdk.calendar.GREGORIAN.monthName :msg}",
    "monthShort": "{sdk.calendar.GREGORIAN.monthShort :msg}",
    "date": {
      "numeric": "{sdk.calendar.GREGORIAN.date.numeric :msg}",
      "long": "{sdk.calendar.GREGORIAN.date.long :msg}",
      "full": "{sdk.calendar.GREGORIAN.date.full :msg}"
    }
  },
  "ISO_WEEK": {
    "date": {
      "numeric": "{$year :integer useGrouping=false}-W{$month :integer minimumIntegerDigits=2}-{$day :integer}",
      "long": "{$year :integer useGrouping=false} का सप्ताह {$month :integer}, दिन {$day :integer}",
      "full": "{sdk.calendar.ISO_WEEK.date.long :msg}"
    }
  },
  "BIKRAM_SAMBAT": {
    "monthName": ".input {$month :integer} .match $month 1 {{वैशाख}} 2 {{ज्येष्ठ}} 3 {{आषाढ़}} 4 {{श्रावण}} 5 {{भाद्रपद}} 6 {{आश्विन}} 7 {{कार्तिक}} 8 {{मार्गशीर्ष}} 9 {{पौष}} 10 {{माघ}} 11 {{फाल्गुन}} 12 {{चैत्र}} * {{{$month}}}",
    "monthShort": "{sdk.calendar.BIKRAM_SAMBAT.monthName :msg}",
    "date": {
      "numeric": "वि.सं. {$year :integer useGrouping=false}/{$month :integer minimumIntegerDigits=2}/{$day :integer minimumIntegerDigits=2}",
      "long": "{$day :integer} {$monthName} वि.सं. {$year :integer useGrouping=false}",
      "full": "{$weekdayName}, {$day :integer} {$monthName} वि.सं. {$year :integer useGrouping=false}"
    }
  },
  "INDIAN_NATIONAL": {
    "monthName": ".input {$month :integer} .match $month 1 {{चैत्र}} 2 {{वैशाख}} 3 {{ज्येष्ठ}} 4 {{आषाढ़}} 5 {{श्रावण}} 6 {{भाद्र}} 7 {{आश्विन}} 8 {{कार्तिक}} 9 {{अग्रहायण}} 10 {{पौष}} 11 {{माघ}} 12 {{फाल्गुन}} * {{{$month}}}",
    "monthShort": "{sdk.calendar.INDIAN_NATIONAL.monthName :msg}",
    "date": {
      "numeric": "शक {$year :integer useGrouping=false}/{$month :integer minimumIntegerDigits=2}/{$day :integer minimumIntegerDigits=2}",
      "long": "{$day :integer} {$monthName} शक {$year :integer useGrouping=false}",
      "full": "{$weekdayName}, {$day :integer} {$monthName} शक {$year :integer useGrouping=false}"
    }
  },
  "HIJRI_TABULAR": {
    "monthName": ".input {$month :integer} .match $month 1 {{मुहर्रम}} 2 {{सफ़र}} 3 {{रबी-उल-अव्वल}} 4 {{रबी-उस-सानी}} 5 {{जुमादा-उल-अव्वल}} 6 {{जुमादा-उस-सानी}} 7 {{रजब}} 8 {{शाबान}} 9 {{रमज़ान}} 10 {{शव्वाल}} 11 {{ज़ी-क़ादा}} 12 {{ज़ी-हिज्जा}} * {{{$month}}}",
    "monthShort": "{sdk.calendar.HIJRI_TABULAR.monthName :msg}",
    "date": {
      "numeric": "{$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2} हिजरी",
      "long": "{$day :integer} {$monthName} {$year :integer useGrouping=false} हिजरी",
      "full": "{$weekdayName}, {$day :integer} {$monthName} {$year :integer useGrouping=false} हिजरी"
    }
  },
  "TIBETAN_PHUGPA": {
    "monthName": ".input {$leap :string} .match $leap MONTH {{अधिक मास {$month :integer}}} MONTH_AND_DAY {{अधिक मास {$month :integer}}} * {{मास {$month :integer}}}",
    "monthShort": ".input {$leap :string} .match $leap MONTH {{अधिक {$month :integer}}} MONTH_AND_DAY {{अधिक {$month :integer}}} * {{{$month :integer}}}",
    "date": {
      "numeric": ".input {$leap :string} .match $leap MONTH {{{$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2} (अधिक मास)}} DAY {{{$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2} (वृद्धि तिथि)}} MONTH_AND_DAY {{{$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2} (अधिक मास, वृद्धि तिथि)}} * {{{$year :integer useGrouping=false}-{$month :integer minimumIntegerDigits=2}-{$day :integer minimumIntegerDigits=2}}}",
      "long": ".input {$leap :string} .match $leap DAY {{{$monthName}, तिथि {$day :integer} (वृद्धि तिथि), {$year :integer useGrouping=false}}} MONTH_AND_DAY {{{$monthName}, तिथि {$day :integer} (वृद्धि तिथि), {$year :integer useGrouping=false}}} * {{{$monthName}, तिथि {$day :integer}, {$year :integer useGrouping=false}}}",
      "full": ".input {$leap :string} .match $leap DAY {{{$weekdayName}, {$monthName}, तिथि {$day :integer} (वृद्धि तिथि), {$year :integer useGrouping=false}}} MONTH_AND_DAY {{{$weekdayName}, {$monthName}, तिथि {$day :integer} (वृद्धि तिथि), {$year :integer useGrouping=false}}} * {{{$weekdayName}, {$monthName}, तिथि {$day :integer}, {$year :integer useGrouping=false}}}"
    }
  },
  "BANGLADESHI": {
    "monthName": ".input {$month :integer} .match $month 1 {{वैशाख}} 2 {{ज्येष्ठ}} 3 {{आषाढ़}} 4 {{श्रावण}} 5 {{भाद्र}} 6 {{आश्विन}} 7 {{कार्तिक}} 8 {{अग्रहायण}} 9 {{पौष}} 10 {{माघ}} 11 {{फाल्गुन}} 12 {{चैत्र}} * {{{$month}}}",
    "monthShort": "{sdk.calendar.BANGLADESHI.monthName :msg}",
    "date": {
      "numeric": "बंगाब्द {$year :integer useGrouping=false}/{$month :integer minimumIntegerDigits=2}/{$day :integer minimumIntegerDigits=2}",
      "long": "{$day :integer} {$monthName} बंगाब्द {$year :integer useGrouping=false}",
      "full": "{$weekdayName}, {$day :integer} {$monthName} बंगाब्द {$year :integer useGrouping=false}"
    }
  },
  "time": {
    "numeric": "{$hour :integer minimumIntegerDigits=2}:{$minute :integer minimumIntegerDigits=2}",
    "long": "{$hour :integer minimumIntegerDigits=2}:{$minute :integer minimumIntegerDigits=2}:{$second :integer minimumIntegerDigits=2}",
    "numeric12": "{$dayPeriod} {$hour12 :integer}:{$minute :integer minimumIntegerDigits=2}",
    "long12": "{$dayPeriod} {$hour12 :integer}:{$minute :integer minimumIntegerDigits=2}:{$second :integer minimumIntegerDigits=2}"
  },
  "datetime": {
    "join": "{$date}, {$time}",
    "inZone": "{$at :datetime timeZone=$zone}"
  },
  "ghati": {
    "numeric": "{$ghati :integer minimumIntegerDigits=2}-{$pala :integer minimumIntegerDigits=2}",
    "long": "{$ghati :integer} घटी {$pala :integer} पल"
  },
  "duration": {
    "day": "{$n :number} दिन",
    "hour": ".input {$n :number} .match $n one {{{$n} घंटा}} * {{{$n} घंटे}}",
    "minute": "{$n :number} मिनट",
    "second": "{$n :number} सेकंड"
  },
  "dayPeriod": {
    "am": "पूर्वाह्न",
    "pm": "अपराह्न",
    "morning": "सुबह",
    "afternoon": "दोपहर",
    "evening": "शाम",
    "night": "रात"
  }
}
