    {
      "key": "SARAVALI_BHANGA_ALL_PLANETS_DIRECT_IN_SIRSHODAYA_SIGNS",
      "category": "arishta-bhanga",
      "source": {
        "text": "Saravali",
        "chapter": "12",
        "verse": "3-5",
        "rank": 1,
        "note": "All the planets in direct motion and in Sirshodaya signs remove every blemish. Saravali ch. 3 v. 24 names those signs: Leo, Libra, Scorpio, Virgo, Aquarius and Gemini. The seven are counted, the nodes being always retrograde; \"every one of them\" is written as no one of them failing, there being no way to ask a condition of all at once. Read from R. Santhanam's translation of Kalyana Varma's Saravali."
      },
      "conditions": [
        {
          "type": "not",
          "condition": {
            "type": "for-any",
            "planets": [
              "SUN",
              "MOON",
              "MARS",
              "MERCURY",
              "JUPITER",
              "VENUS",
              "SATURN"
            ],
            "then": {
              "type": "or",
              "conditions": [
                {
                  "type": "planet-retrograde",
                  "planet": "SELF"
                },
                {
                  "type": "not",
                  "condition": {
                    "type": "planet-in-sign",
                    "planet": "SELF",
                    "signs": [
                      "GEMINI",
                      "LEO",
                      "VIRGO",
                      "LIBRA",
                      "SCORPIO",
                      "AQUARIUS"
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    },
