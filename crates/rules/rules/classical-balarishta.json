  "rules": [
    {
      "key": "BJ_MALEFICS_IN_TWELFTH_AND_SECOND",
      "category": "arishta",
      "source": {
        "text": "Brihat Jataka",
        "chapter": "6",
        "verse": "2",
        "rank": 1,
        "note": "Malefics holding the twelfth and the second from the rising sign: the child dies. The same verse gives the sixth and the eighth as a second figure, and the translator records Garga's four pairs; the verse's own two ship here. Read from N. Chidambaram Iyer's 1885 translation."
      },
      "conditions": [
        {
          "type": "count-in-houses",
          "planets": "any-malefic",
          "houses": [
            12
          ],
          "atLeast": 1
        },
        {
          "type": "count-in-houses",
          "planets": "any-malefic",
          "houses": [
            2
          ],
          "atLeast": 1
        }
      ]
    },
