    {
      "key": "BJ_LUMINARY_IN_LAGNA_MALEFICS_IN_FIVE_EIGHT_NINE",
      "category": "arishta",
      "source": {
        "text": "Brihat Jataka",
        "chapter": "6",
        "verse": "9",
        "rank": 1,
        "note": "The Sun or the Moon in the rising sign with malefics in the fifth, eighth and ninth: the child dies unless that luminary is joined or aspected by a powerful benefic. The escape turns on a benefic's strength, and ships as the rule's cancellation; a chart that carries no strength never fires it. Read from N. Chidambaram Iyer's 1885 translation."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "planet-in-house",
              "planet": "SUN",
              "houses": [
                1
              ]
            },
            {
              "type": "planet-in-house",
              "planet": "MOON",
              "houses": [
                1
              ]
            }
          ]
        },
        {
          "type": "count-in-houses",
          "planets": "any-malefic",
          "houses": [
            5
          ],
          "atLeast": 1
        },
        {
          "type": "count-in-houses",
          "planets": "any-malefic",
          "houses": [
            8
          ],
          "atLeast": 1
        },
        {
          "type": "count-in-houses",
          "planets": "any-malefic",
          "houses": [
            9
          ],
          "atLeast": 1
        }
      ],
      "cancellations": [
        {
          "label": "a powerful benefic joins or aspects the luminary in the rising sign",
          "type": "for-any",
          "planets": [
            "MERCURY",
            "JUPITER",
            "VENUS"
          ],
          "then": {
            "type": "and",
            "conditions": [
              {
                "type": "planet-strong",
                "planet": "SELF"
              },
              {
                "type": "or",
                "conditions": [
                  {
                    "type": "planet-in-house",
                    "planet": "SELF",
                    "houses": [
                      1
                    ]
                  },
                  {
                    "type": "planet-aspects-house",
                    "from": "SELF",
                    "houseRuled": 1
                  }
                ]
              }
            ]
          }
        }
      ]
    },
