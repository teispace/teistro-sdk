{
  "rules": [
    {
      "key": "TITHI_GANDANTA",
      "category": "gandanta",
      "source": {
        "text": "BPHS",
        "chapter": "92",
        "verse": "2",
        "rank": 1,
        "note": "The last two ghatikas of a Purna tithi (the 5th, 10th and 15th) and the first two of a Nanda tithi (the 1st, 6th and 11th), in either paksha. Read from R. Santhanam's translation; the ghatika is 24 minutes, and a chart that does not measure the tithi's ghatikas cannot answer this."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "and",
              "conditions": [
                {
                  "type": "panchanga-tithi",
                  "tithis": [
                    "SHUKLA_PANCHAMI",
                    "SHUKLA_DASHAMI",
                    "PURNIMA",
                    "KRISHNA_PANCHAMI",
                    "KRISHNA_DASHAMI",
                    "AMAVASYA"
                  ]
                },
                {
                  "type": "at-limb-edge",
                  "limb": "tithi",
                  "edge": "last",
                  "ghatikas": 2.0
                }
              ]
            },
            {
              "type": "and",
              "conditions": [
                {
                  "type": "panchanga-tithi",
                  "tithis": [
                    "SHUKLA_PRATIPADA",
                    "SHUKLA_SHASHTHI",
                    "SHUKLA_EKADASHI",
                    "KRISHNA_PRATIPADA",
                    "KRISHNA_SHASHTHI",
                    "KRISHNA_EKADASHI"
                  ]
                },
                {
                  "type": "at-limb-edge",
                  "limb": "tithi",
                  "edge": "first",
                  "ghatikas": 2.0
                }
              ]
            }
          ]
        }
      ],
      "severityRule": {
        "type": "fixed",
        "value": 100
      },
      "remedyKeys": [
        "GANDANTA_REMEDY_BULLOCK_IN_CHARITY"
      ]
    },
