{
  "rules": [
    {
      "key": "PARASHARA_KAHALA",
      "category": "miscellaneous",
      "source": {
        "text": "BPHS",
        "chapter": "36",
        "verse": "9-10",
        "rank": 1,
        "note": "The lord of the fourth and Jupiter in mutual angles while the lord of the ascendant is strong; or the lord of the fourth in his own or exaltation sign sharing a sign with the lord of the tenth. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "and",
              "conditions": [
                {
                  "type": "planet-in-kendra-from",
                  "planet": {
                    "lordOf": 4
                  },
                  "reference": "JUPITER"
                },
                {
                  "type": "planet-strong",
                  "planet": {
                    "lordOf": 1
                  }
                }
              ]
            },
            {
              "type": "and",
              "conditions": [
                {
                  "type": "planet-dignity",
                  "planet": {
                    "lordOf": 4
                  },
                  "dignities": [
                    "EXALTED",
                    "OWN_SIGN"
                  ]
                },
                {
                  "type": "lord-conjunct-lord",
                  "house1": 4,
                  "house2": 10
                }
              ]
            }
          ]
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "energetic, adventurous, cunning, furnished with a whole army of chariots, elephants, horses and foot, and lord of a few villages"
        }
      ]
    },
