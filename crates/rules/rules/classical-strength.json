    {
      "key": "PARASHARA_MRIDANGA",
      "category": "miscellaneous",
      "source": {
        "text": "BPHS",
        "chapter": "36",
        "verse": "17",
        "rank": 1,
        "note": "The lord of the ascendant strong while the rest stand in angles, trines, their own houses or their exaltations. The verse says \"others\"; this rule asks it of all seven, the lord of the ascendant among them, there being no way to name the rest of a set. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "planet-strong",
          "planet": {
            "lordOf": 1
          }
        },
        {
          "type": "not",
          "condition": {
            "type": "for-any",
            "planets": [
              "SUN",
              "MOON",
              "MARS",
              "MERCURY",
              "JUPITER",
              "VENUS",
              "SATURN"
            ],
            "then": {
              "type": "not",
              "condition": {
                "type": "or",
                "conditions": [
                  {
                    "type": "planet-in-house",
                    "planet": "SELF",
                    "houses": [
                      1,
                      4,
                      5,
                      7,
                      9,
                      10
                    ]
                  },
                  {
                    "type": "planet-dignity",
                    "planet": "SELF",
                    "dignities": [
                      "EXALTED",
                      "OWN_SIGN",
                      "MOOLTRIKONA"
                    ]
                  }
                ]
              }
            }
          }
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "a king or the equal of a king, and happy"
        }
      ]
    },
