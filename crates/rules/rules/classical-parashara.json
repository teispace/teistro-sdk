    {
      "key": "PARASHARA_GAJA_KESARI",
      "category": "chandra",
      "source": {
        "text": "BPHS",
        "chapter": "36",
        "verse": "3-4",
        "rank": 1,
        "note": "Jupiter in an angle from the ascendant or from the Moon, joined or aspected by another benefic, and neither debilitated, combust nor in an enemy's sign. Another benefic is written as a second benefic in Jupiter's own sign, Jupiter being one himself, and as a benefic aspecting him, which he cannot do to himself. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "planet-in-kendra",
              "planet": "JUPITER"
            },
            {
              "type": "planet-in-kendra-from",
              "planet": "JUPITER",
              "reference": "MOON"
            }
          ]
        },
        {
          "type": "or",
          "conditions": [
            {
              "type": "count-in-houses",
              "planets": "any-benefic",
              "houses": [
                1
              ],
              "atLeast": 2,
              "from": "JUPITER"
            },
            {
              "type": "count-aspecting",
              "planets": "any-benefic",
              "target": "JUPITER",
              "atLeast": 1
            }
          ]
        },
        {
          "type": "not",
          "condition": {
            "type": "planet-dignity",
            "planet": "JUPITER",
            "dignities": [
              "DEBILITATED",
              "ENEMY",
              "GREAT_ENEMY"
            ]
          }
        },
        {
          "type": "not",
          "condition": {
            "type": "planet-combust",
            "planet": "JUPITER"
          }
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "splendid, wealthy, intelligent, endowed with many laudable virtues, and pleasing to the king"
        }
      ]
    },
