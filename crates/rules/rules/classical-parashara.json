    {
      "key": "MAHAPURUSHA_RUCHAKA",
      "category": "mahapurusha",
      "source": {
        "text": "Saravali",
        "chapter": "37",
        "verse": "5-7",
        "rank": 1,
        "note": "Mars in his own sign or his exaltation, standing in an angle from the ascendant. Read from R. Santhanam's translation of Kalyana Varma's Saravali; the Parashara chapter gives the same figure at ch. 75 vv. 1 to 2."
      },
      "conditions": [
        {
          "type": "planet-in-kendra",
          "planet": "MARS"
        },
        {
          "type": "planet-dignity",
          "planet": "MARS",
          "dignities": [
            "EXALTED",
            "OWN_SIGN",
            "MOOLTRIKONA"
          ]
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "long of face, of pure splendour, greatly strong, valorous, of attractive brows and very black hair, warlike, knowing mantras, a leader of thieves, blood-red of complexion, a conqueror of his enemies, conch-necked, a chief, cruel, honouring the gods and Brahmins, thin of shank, a hundred inches tall, and a ruler of the Vindhya and the Sahya"
        },
        {
          "type": "life-span",
          "count": 70.0,
          "unit": "years"
        }
      ]
    },
    {
      "key": "MAHAPURUSHA_BHADRA",
      "category": "mahapurusha",
      "source": {
        "text": "Saravali",
        "chapter": "37",
        "verse": "14-18",
        "rank": 1,
        "note": "Mercury in his own sign or his exaltation, standing in an angle from the ascendant. Read from R. Santhanam's translation of Kalyana Varma's Saravali; the Parashara chapter gives the same figure at ch. 75 vv. 1 to 2."
