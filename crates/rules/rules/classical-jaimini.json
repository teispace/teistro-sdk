    {
      "key": "ARUDHA_GAINS_BENEFIC_ASPECT_FROM_LAGNA_OR_NINTH",
      "category": "dhana",
      "source": {
        "text": "BPHS",
        "chapter": "29",
        "verse": "15",
        "rank": 1,
        "note": "A benefic standing in the ascendant or the ninth and aspecting the eleventh from the pada of the ascendant; the verse ranks the ninth above the ascendant, which the SDK does not grade. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "for-any",
          "planets": [
            "MERCURY",
            "JUPITER",
            "VENUS"
          ],
          "then": {
            "type": "and",
            "conditions": [
              {
                "type": "planet-in-house",
                "planet": "SELF",
                "houses": [
                  1,
                  9
                ]
              },
              {
                "type": "planet-aspects-planet",
                "from": "SELF",
                "target": {
                  "from": {
                    "arudha": 1
                  },
                  "house": 11
                }
              }
            ]
          }
        },
        {
          "type": "not",
          "condition": {
            "type": "count-in-houses",
            "planets": "any-malefic",
            "houses": [
              1
            ],
            "from": {
              "from": {
                "arudha": 1
              },
              "house": 12
            },
            "atLeast": 1
          }
        },
        {
          "type": "not",
          "condition": {
            "type": "planet-aspects-planet",
            "from": "any-malefic",
            "target": {
              "from": {
                "arudha": 1
              },
              "house": 12
            }
          }
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "gains increasing in the ascending order, a benefic in the ascendant or the ninth aspecting the eleventh from the pada"
        }
      ]
    },
    {
      "key": "JAIMINI_AK_PK_ASSOCIATED",
      "category": "jaimini",
      "source": {
        "text": "BPHS",
        "chapter": "39",
        "verse": "3-5",
        "rank": 1,
        "note": "The Atmakaraka and the Putrakaraka associated: sharing a sign, or aspecting one another by rashi drishti, which is the aspect ch. 26 gives the signs and Jaimini reads by. The verse grades the effect full, half or a quarter by their strengths, which the kernel cannot measure. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "planet-conjunct",
              "planets": [
                {
                  "karaka": "AK"
                },
                {
                  "karaka": "PK"
                }
              ]
            },
            {
              "type": "rashi-aspects",
              "from": {
                "karaka": "AK"
              },
              "target": {
                "karaka": "PK"
              }
            }
          ]
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "entitled to royal honours, the Atmakaraka and the Putrakaraka standing together"
        }
      ]
    },
    {
      "key": "JAIMINI_LAGNA_AND_FIFTH_LORDS_ASSOCIATED",
      "category": "jaimini",
      "source": {
        "text": "BPHS",
        "chapter": "39",
        "verse": "3-5",
        "rank": 1,
        "note": "The lord of the ascendant and the lord of the fifth associated, read from the natal ascendant as the same verses direct: sharing a sign, or aspecting one another by rashi drishti. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "lord-conjunct-lord",
              "house1": 1,
              "house2": 5
            },
            {
              "type": "rashi-aspects",
              "from": {
                "lordOf": 1
              },
              "target": {
                "lordOf": 5
              }
            }
          ]
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "entitled to royal honours, the lord of the ascendant and the lord of the fifth standing together"
        }
      ]
    }
