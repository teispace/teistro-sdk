                "from": {
                  "arudha": 1
                },
                "house": 11
              },
              "place": "eleventh"
            }
          ]
        },
        {
          "type": "not",
          "condition": {
            "type": "count-in-houses",
            "planets": "any-malefic",
            "houses": [
              1
            ],
            "from": {
              "from": {
                "arudha": 1
              },
              "house": 12
            },
            "atLeast": 1
          }
        },
        {
          "type": "not",
          "condition": {
            "type": "planet-aspects-planet",
            "from": "any-malefic",
            "target": {
              "from": {
                "arudha": 1
              },
              "house": 12
            }
          }
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "greater gains, an intervention standing on the eleventh from the pada"
        }
      ]
    },
