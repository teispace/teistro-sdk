{
  "rules": [
    {
      "key": "ARUDHA_GAINS",
      "category": "dhana",
      "source": {
        "text": "BPHS",
        "chapter": "29",
        "verse": "13",
        "rank": 1,
        "note": "Grahas standing in or aspecting the eleventh from the pada of the ascendant, the twelfth from that pada being free of a malefic standing in it or aspecting it. The verse grades the gains by how many reach the eleventh, which the SDK reports as the rule's participants rather than as a number of its own. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "count-in-houses",
              "planets": "any-benefic",
              "houses": [
                1
              ],
              "from": {
                "from": {
                  "arudha": 1
                },
                "house": 11
              },
              "atLeast": 1
            },
            {
              "type": "count-in-houses",
              "planets": "any-malefic",
              "houses": [
                1
              ],
              "from": {
                "from": {
                  "arudha": 1
                },
                "house": 11
              },
              "atLeast": 1
            },
            {
              "type": "planet-aspects-planet",
              "from": "any-benefic",
              "target": {
                "from": {
                  "arudha": 1
                },
                "house": 11
              }
            },
            {
              "type": "planet-aspects-planet",
              "from": "any-malefic",
              "target": {
                "from": {
                  "arudha": 1
                },
                "house": 11
              }
            }
          ]
        },
        {
          "type": "not",
          "condition": {
            "type": "count-in-houses",
            "planets": "any-malefic",
            "houses": [
              1
            ],
            "from": {
              "from": {
                "arudha": 1
              },
              "house": 12
            },
            "atLeast": 1
          }
        },
        {
          "type": "not",
          "condition": {
            "type": "planet-aspects-planet",
            "from": "any-malefic",
            "target": {
              "from": {
                "arudha": 1
              },
              "house": 12
            }
          }
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "gains, in proportion to the grahas standing in or aspecting the eleventh from the pada of the ascendant"
        }
      ]
    },
    {
