{
  "rules": [
    {
      "key": "PRAVRAJYA_SUN",
      "category": "pravrajya",
      "source": {
        "text": "BPHS",
        "chapter": "79",
        "verse": "2-3",
        "rank": 1,
        "note": "Four or more grahas possessed of strength in one house, Sun the strongest of them. The verse asks three things the kernel could not say until it could compare strengths: that four share a house, that each of them is strong, and that this one is the strongest there. A chart carrying no strength answers none of it. Verse 10's relinquishing, when the graha that led to the order is beaten in planetary war, wants a victor the chart does not carry (v. 9 decides it by latitude), and is not built; nor are vv. 11 to 13, where every graha being strong gives the native every order in turn, in the sequence of their dashas. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "planet-strong",
          "planet": "SUN"
        },
        {
          "type": "n-grahas-conjunct-with",
          "anchor": "SUN",
          "minCount": 4
        },
        {
          "type": "not",
          "condition": {
            "type": "for-any",
            "planets": [
              "SUN",
              "MOON",
              "MARS",
              "MERCURY",
              "JUPITER",
              "VENUS",
              "SATURN"
            ],
            "then": {
              "type": "and",
              "conditions": [
                {
                  "type": "same-sign",
                  "of": "SELF",
                  "as": "SUN"
                },
                {
                  "type": "not",
                  "condition": {
                    "type": "planet-strong",
                    "planet": "SELF"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "not",
          "condition": {
            "type": "for-any",
            "planets": [
              "SUN",
              "MOON",
              "MARS",
              "MERCURY",
              "JUPITER",
              "VENUS",
              "SATURN"
            ],
            "then": {
              "type": "and",
              "conditions": [
                {
                  "type": "same-sign",
                  "of": "SELF",
                  "as": "SUN"
                },
                {
                  "type": "planet-stronger-than",
                  "planet": "SELF",
                  "than": "SUN"
                }
              ]
            }
          }
        }
      ],
      "cancellations": [
        {
          "label": "the graha that leads to the order is combust",
          "type": "planet-combust",
          "planet": "SUN"
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "initiated into a holy order, a Tapasvi"
        }
      ]
    },
