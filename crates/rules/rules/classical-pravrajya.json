    {
      "key": "PRAVRAJYA_MOON_IN_A_NAVAMSHA_OF_SATURN_OR_MARS_ASPECTED_BY_SATURN",
      "category": "pravrajya",
      "source": {
        "text": "BPHS",
        "chapter": "79",
        "verse": "8",
        "rank": 1,
        "note": "The Moon in a navamsha of Saturn or of Mars and aspected by Saturn. The verse's other branch, the Moon in a decanate of Saturn, wants a catalogue of the decanates and is not built. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "planet-in-sign",
          "planet": {
            "navamsha": "MOON"
          },
          "signs": [
            "CAPRICORN",
            "AQUARIUS",
            "ARIES",
            "SCORPIO"
          ]
