    {
      "key": "PRAVRAJYA_MOON_LORD_ASPECTS_SATURN_AND_IS_STRONGER",
      "category": "pravrajya",
      "source": {
        "text": "BPHS",
        "chapter": "79",
        "verse": "6",
        "rank": 1,
        "note": "The lord of the sign the Moon occupies, with no graha aspecting him, aspecting Saturn: the order of whichever of the two is stronger, and here it is the lord. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "not",
          "condition": {
            "type": "for-any",
            "planets": [
              "SUN",
              "MOON",
              "MARS",
              "MERCURY",
              "JUPITER",
              "VENUS",
              "SATURN"
            ],
            "then": {
              "type": "planet-aspects-planet",
              "from": "SELF",
              "target": {
                "lordOf": "MOON"
              }
            }
          }
        },
        {
          "type": "planet-aspects-planet",
          "from": {
            "lordOf": "MOON"
          },
          "target": "SATURN"
        },
        {
          "type": "planet-stronger-than",
          "planet": {
            "lordOf": "MOON"
          },
          "than": "SATURN"
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "initiated into the holy order of the lord of the Moon's sign, he being the stronger of the two"
        }
      ]
    },
