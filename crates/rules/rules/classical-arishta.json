{
  "rules": [
    {
      "key": "ARISHTA_MOON_IN_DUSTHANA_MALEFIC_ASPECT",
      "category": "arishta",
      "source": {
        "text": "BPHS",
        "chapter": "9",
        "verse": "3-6",
        "rank": 1,
        "note": "The Moon in the sixth, eighth or twelfth from the lagna and aspected by a malefic: the child dies soon. The verse adds that a benefic's aspect in the same figure leaves it living to about eight, which is a grading the SDK does not model."
      },
      "conditions": [
        {
          "type": "and",
          "conditions": [
            {
              "type": "planet-in-house",
              "planet": "MOON",
              "houses": [
                6,
                8,
                12
              ]
            },
            {
              "type": "planet-aspects-planet",
              "from": "any-malefic",
              "target": "MOON"
            }
          ]
        }
      ]
    },
    {
      "key": "ARISHTA_RETROGRADE_BENEFIC_IN_DUSTHANA",
      "category": "arishta",
      "source": {
        "text": "BPHS",
        "chapter": "9",
        "verse": "3-6",
        "rank": 1,
        "note": "A benefic retrograde in the sixth, eighth or twelfth and aspected by a malefic, the lagna unoccupied by a benefic: death within a month of birth."
      },
      "conditions": [
        {
          "type": "for-any",
          "planets": [
            "MERCURY",
            "JUPITER",
            "VENUS",
            "MOON"
          ],
          "then": {
            "type": "and",
            "conditions": [
              {
                "type": "planet-retrograde",
                "planet": "SELF"
              },
              {
                "type": "planet-in-house",
                "planet": "SELF",
                "houses": [
                  6,
                  8,
                  12
                ]
              },
              {
                "type": "planet-aspects-planet",
                "from": "any-malefic",
                "target": "SELF"
              }
            ]
          }
        },
        {
          "type": "not",
          "condition": {
            "type": "count-in-houses",
            "planets": "any-benefic",
            "houses": [
              1
            ],
            "atLeast": 1
          }
        }
      ]
    },
    {
      "key": "ARISHTA_SATURN_MARS_SUN_IN_FIFTH",
      "category": "arishta",
      "source": {
        "text": "BPHS",
        "chapter": "9",
        "verse": "3-6",
        "rank": 1,
        "note": "Saturn, Mars and the Sun together in the fifth: the early death of the mother and of a brother."
      },
      "conditions": [
        {
          "type": "planet-in-house",
          "planet": "SATURN",
          "houses": [
            5
          ]
        },
        {
          "type": "planet-in-house",
          "planet": "MARS",
          "houses": [
            5
          ]
        },
        {
          "type": "planet-in-house",
          "planet": "SUN",
          "houses": [
            5
          ]
        }
      ]
    },
    {
      "key": "ARISHTA_MARS_IN_LAGNA_OR_EIGHTH",
      "category": "arishta",
      "source": {
        "text": "BPHS",
        "chapter": "9",
        "verse": "3-6",
        "rank": 1,
        "note": "Mars in the lagna or the eighth, conjunct Saturn or the Sun or aspected by a malefic, and with no benefic's aspect: a source of immediate death."
      },
      "conditions": [
        {
          "type": "planet-in-house",
          "planet": "MARS",
          "houses": [
            1,
            8
          ]
        },
        {
          "type": "or",
          "conditions": [
            {
              "type": "planet-conjunct",
              "planets": [
                "MARS",
                "SATURN"
              ]
            },
            {
              "type": "planet-conjunct",
              "planets": [
                "MARS",
                "SUN"
              ]
            },
            {
              "type": "planet-aspects-planet",
              "from": "any-malefic",
              "target": "MARS"
            }
          ]
        },
        {
          "type": "not",
          "condition": {
            "type": "planet-aspects-planet",
            "from": "any-benefic",
            "target": "MARS"
          }
        }
      ]
    },
    {
      "key": "ARISHTA_NODES_WITH_LUMINARIES_LAGNA_AFFLICTED",
      "category": "arishta",
      "source": {
        "text": "BPHS",
        "chapter": "9",
        "verse": "7-11",
        "rank": 1,
        "note": "Saturn and Mars both aspecting the lagna while the Sun and the Moon join Rahu elsewhere: the child lives only a fortnight."
      },
      "conditions": [
        {
          "type": "planet-aspects-house",
          "from": "SATURN",
          "houseRuled": 1
        },
        {
          "type": "planet-aspects-house",
          "from": "MARS",
          "houseRuled": 1
        },
        {
          "type": "planet-conjunct",
          "planets": [
            "SUN",
            "MOON",
            "RAHU"
          ]
        }
      ]
    },
