    {
      "key": "ARISHTA_BHANGA_BENEFIC_IN_KENDRA",
      "category": "arishta-bhanga",
      "source": {
        "text": "BPHS",
        "chapter": "10",
        "verse": "2",
        "rank": 1,
        "note": "Mercury, Jupiter or Venus in a kendra from the lagna destroys all the evils, as the Sun eliminates darkness. The antidotes stand in their own chapter, so they ship as rules of their own rather than as each evil's cancellation; a rule that carries them awaits a way to name a condition once and reference it."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "planet-in-house",
              "planet": "MERCURY",
              "houses": [
                1,
                4,
                7,
                10
              ]
            },
            {
              "type": "planet-in-house",
              "planet": "JUPITER",
              "houses": [
                1,
                4,
                7,
                10
              ]
            },
            {
              "type": "planet-in-house",
              "planet": "VENUS",
              "houses": [
                1,
                4,
                7,
                10
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "ARISHTA_BHANGA_LAGNA_ASPECTED_BY_PAKSHA",
      "category": "arishta-bhanga",
      "source": {
        "text": "BPHS",
        "chapter": "10",
        "verse": "5",
        "rank": 1,
        "note": "A benefic aspecting the lagna of a night birth in the bright half, or a malefic aspecting the lagna of a day birth in the dark half, destroys all the evils. It needs the chart to say whether the birth was by day."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "and",
              "conditions": [
                {
                  "type": "panchanga-paksha",
                  "paksha": "shukla"
                },
                {
                  "type": "not",
                  "condition": {
                    "type": "birth-by-day"
                  }
                },
                {
                  "type": "planet-aspects-house",
                  "from": "any-benefic",
                  "houseRuled": 1
                }
              ]
            },
            {
              "type": "and",
              "conditions": [
                {
                  "type": "panchanga-paksha",
                  "paksha": "krishna"
                },
                {
                  "type": "birth-by-day"
                },
                {
                  "type": "planet-aspects-house",
                  "from": "any-malefic",
                  "houseRuled": 1
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "key": "ARISHTA_BHANGA_BENEFICS_IN_KENDRAS_AND_TRIKONAS",
      "category": "arishta-bhanga",
      "source": {
        "text": "BPHS",
        "chapter": "10",
        "verse": "9",
        "rank": 1,
        "note": "Malefics surrounded by benefics while the kendras and trikonas are themselves benefic-occupied: the evils disappear soon, and do not follow from those bhavas. This rule reads the second half, benefics in the kendras and trikonas."
      },
      "conditions": [
        {
          "type": "count-in-houses",
          "planets": "any-benefic",
          "houses": [
            1,
            4,
            5,
            7,
            9,
            10
          ],
          "atLeast": 2
        }
      ]
    },
    {
      "key": "ARISHTA_BHANGA_MARS_WITH_JUPITER",
      "category": "arishta-bhanga",
      "source": {
        "text": "BPHS",
        "chapter": "10",
        "verse": "7",
        "rank": 1,
        "note": "Mars joined by Jupiter or aspected by him is auspicious for the mother as well as for the native."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "planet-conjunct",
              "planets": [
                "MARS",
                "JUPITER"
              ]
            },
            {
              "type": "planet-aspects-planet",
              "from": "JUPITER",
              "target": "MARS"
            }
          ]
        }
      ]
    }
