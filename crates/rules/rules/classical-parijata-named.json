        "chapter": "7",
        "verse": "128-129",
        "rank": 1,
        "note": "Benefics in the kendras while the sixth and the eighth are empty or hold benefics alone, the plural read as one benefic at least; or the lords of the lagna and the twelfth, two grahas, in kendras from each other, each aspected by a natural friend. BPHS ch. 36 keeps the seventh and the eighth empty and has no second clause. Read from V. Subrahmanya Sastri's 1932 translation."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "and",
              "conditions": [
                {
                  "type": "count-in-houses",
                  "planets": "any-benefic",
                  "houses": [
                    1,
                    4,
                    7,
                    10
                  ],
                  "atLeast": 1
                },
                {
                  "type": "not",
                  "condition": {
                    "type": "count-in-houses",
                    "planets": "any-malefic",
                    "houses": [
                      6,
                      8
                    ],
                    "atLeast": 1
                  }
                }
              ]
            },
            {
              "type": "and",
              "conditions": [
                {
                  "type": "not",
                  "condition": {
                    "type": "same-body",
                    "of": {
                      "lordOf": 1
                    },
                    "as": {
                      "lordOf": 12
                    }
                  }
                },
