                        "of": {
                          "lordOf": 1
                        },
                        "to": "SELF",
                        "relations": [
                          "friend"
                        ]
                      },
                      {
                        "type": "planet-aspects-planet",
                        "from": "SELF",
                        "target": {
                          "lordOf": 1
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "for-any",
                  "planets": [
                    "SUN",
                    "MOON",
                    "MARS",
                    "MERCURY",
