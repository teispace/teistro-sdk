    {
      "key": "BPHS_LAGNA_AND_TWELFTH_LORDS_EXCHANGED_WITH_A_MARAKA",
      "category": "daridra",
      "source": {
        "text": "BPHS",
        "chapter": "42",
        "verse": "2",
        "rank": 1,
        "note": "The lagna lord in the twelfth while the twelfth lord stands in the lagna, the twelfth lord joined or aspected by a maraka. The translation attaches the maraka to the twelfth lord in the lagna, and so does this rule. A maraka is BPHS ch. 44 vv. 3 to 5's: a lord of the second or the seventh, a malefic standing in either, or a malefic joining either lord. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "planet-in-house",
          "planet": {
            "lordOf": 1
          },
          "houses": [
            12
          ]
        },
        {
          "type": "planet-in-house",
          "planet": {
            "lordOf": 12
          },
          "houses": [
            1
          ]
        },
        {
          "type": "or",
          "conditions": [
            {
              "type": "count-in-houses",
              "planets": "any-maraka",
              "houses": [
                1
              ],
              "from": {
                "lordOf": 12
              },
              "except": [
                {
                  "lordOf": 12
                }
              ],
              "atLeast": 1
            },
            {
              "type": "planet-aspects-planet",
              "from": "any-maraka",
              "target": {
                "lordOf": 12
              }
            }
          ]
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "penniless"
        }
      ]
    },
