    {
      "key": "NEECHA_BHANGA_RETROGRADE",
      "category": "neecha-bhanga",
      "source": {
        "text": "Phaladeepika",
        "chapter": "6",
        "note": "A retrograde debilitated graha, by its vakri bala; the nodes, always retrograde, are left out. The recording engine cites BPHS ch. 38 v. 12 for the six conditions; the translation read (`scratchpad/bphs.txt`) carries no such list there, so the rank-1 source is unsettled (crux C87). The condition itself is the one that engine computes in code, said here in the language."
      },
      "conditions": [
        {
          "type": "for-any",
          "planets": [
            "SUN",
            "MOON",
            "MARS",
            "MERCURY",
            "JUPITER",
            "VENUS",
            "SATURN"
          ],
          "then": {
            "type": "and",
            "conditions": [
              {
                "type": "planet-dignity",
                "planet": "SELF",
                "dignities": [
                  "DEBILITATED"
                ]
              },
              {
                "type": "planet-retrograde",
