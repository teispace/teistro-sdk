{
  "rules": [
    {
      "key": "NEECHA_BHANGA_RAJA",
      "category": "neecha-bhanga",
      "source": {
        "text": "BPHS",
        "chapter": "38",
        "note": "Any one of the seven cancellations below lifting any debilitated graha. The recording engine cites BPHS ch. 38 v. 12 for the six conditions; the translation read (`scratchpad/bphs.txt`) carries no such list there, so the rank-1 source is unsettled (crux C87). The condition itself is the one that engine computes in code, said here in the language."
      },
      "conditions": [
        {
          "type": "for-any",
          "then": {
            "type": "and",
            "conditions": [
              {
                "type": "planet-dignity",
                "planet": "SELF",
                "dignities": [
                  "DEBILITATED"
                ]
              },
              {
                "type": "or",
                "conditions": [
                  {
                    "type": "or",
                    "conditions": [
                      {
                        "type": "planet-in-kendra",
                        "planet": {
                          "lordOf": {
                            "debilitationOf": "SELF"
                          }
                        }
                      },
                      {
                        "type": "planet-in-kendra-from",
                        "planet": {
                          "lordOf": {
                            "debilitationOf": "SELF"
                          }
                        },
                        "reference": "MOON"
                      }
                    ]
                  },
                  {
                    "type": "or",
                    "conditions": [
                      {
                        "type": "planet-in-kendra",
                        "planet": {
                          "exaltedIn": {
                            "debilitationOf": "SELF"
                          }
                        }
                      },
                      {
                        "type": "planet-in-kendra-from",
                        "planet": {
                          "exaltedIn": {
                            "debilitationOf": "SELF"
                          }
                        },
                        "reference": "MOON"
                      }
                    ]
                  },
                  {
                    "type": "same-sign",
                    "of": {
                      "navamsha": "SELF"
                    },
                    "as": {
                      "exaltationOf": "SELF"
                    }
                  },
                  {
                    "type": "or",
                    "conditions": [
                      {
                        "type": "planet-aspects-planet",
                        "from": "JUPITER",
                        "target": "SELF"
                      },
                      {
                        "type": "planet-aspects-planet",
                        "from": "VENUS",
                        "target": "SELF"
                      },
                      {
                        "type": "planet-aspects-planet",
                        "from": "MOON",
                        "target": "SELF"
                      },
                      {
                        "type": "planet-aspects-planet",
                        "from": "MERCURY",
                        "target": "SELF"
                      }
                    ]
                  },
                  {
                    "type": "same-body",
                    "of": {
                      "lordOf": {
                        "navamsha": "SELF"
                      }
                    },
                    "as": "SELF"
                  },
                  {
                    "type": "or",
                    "conditions": [
                      {
                        "type": "planet-in-kendra",
                        "planet": {
                          "lordOf": {
                            "exaltationOf": "SELF"
                          }
                        }
                      },
                      {
                        "type": "planet-in-kendra-from",
                        "planet": {
                          "lordOf": {
                            "exaltationOf": "SELF"
                          }
                        },
                        "reference": "MOON"
                      }
                    ]
                  },
                  {
                    "type": "and",
                    "conditions": [
                      {
                        "type": "planet-retrograde",
                        "planet": "SELF"
                      },
                      {
                        "type": "not",
                        "condition": {
                          "type": "or",
                          "conditions": [
                            {
                              "type": "same-body",
                              "of": "SELF",
                              "as": "RAHU"
                            },
                            {
                              "type": "same-body",
                              "of": "SELF",
                              "as": "KETU"
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    },
