    {
      "key": "PARIJATA_THREE_EXALTED_EIGHTH_LORD_IN_A_CLEAN_LAGNA",
      "category": "ayur",
      "source": {
        "text": "Jataka Parijata",
        "chapter": "4",
        "verse": "87",
        "rank": 1,
        "note": "Three grahas exalted, and the lord of the eighth in the lagna with no malefic there: long life. Read from V. Subrahmanya Sastri's 1932 translation."
      },
      "conditions": [
        {
          "type": "count-of",
          "planets": [
            "SUN",
            "MOON",
            "MARS",
            "MERCURY",
            "JUPITER",
            "VENUS",
            "SATURN"
          ],
          "then": {
            "type": "planet-dignity",
            "planet": "SELF",
            "dignities": [
              "EXALTED",
              "DEEP_EXALTED"
            ]
          },
          "atLeast": 3
        },
        {
          "type": "lord-of-house-in-house",
          "houseRuled": 8,
          "houseOccupied": 1
        },
        {
          "type": "not",
          "condition": {
            "type": "count-in-houses",
            "planets": "any-malefic",
            "houses": [
              1
            ],
            "atLeast": 1
          }
        }
      ],
      "outcomes": [
        {
          "type": "life-class",
          "class": "long"
        }
      ]
    },
    {
      "key": "PARIJATA_SATURN_OR_EIGHTH_LORD_WITH_AN_EXALTED_GRAHA",
      "category": "ayur",
      "source": {
        "text": "Jataka Parijata",
        "chapter": "4",
        "verse": "89",
        "rank": 1,
        "note": "Saturn or the lord of the eighth joined with a graha in its exaltation: long life. v. 88's three in the eighth in exaltation, a friend's sign and their own varga is not built. Read from V. Subrahmanya Sastri's 1932 translation."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "for-any",
              "then": {
                "type": "and",
                "conditions": [
                  {
                    "type": "same-sign",
                    "of": "SELF",
                    "as": "SATURN"
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "same-body",
                      "of": "SELF",
                      "as": "SATURN"
                    }
                  },
                  {
                    "type": "planet-dignity",
                    "planet": "SELF",
                    "dignities": [
                      "EXALTED",
                      "DEEP_EXALTED"
                    ]
                  }
                ]
              }
            },
            {
              "type": "for-any",
              "then": {
                "type": "and",
                "conditions": [
                  {
                    "type": "same-sign",
                    "of": "SELF",
                    "as": {
                      "lordOf": 8
                    }
                  },
                  {
                    "type": "not",
                    "condition": {
                      "type": "same-body",
                      "of": "SELF",
                      "as": {
                        "lordOf": 8
                      }
                    }
                  },
                  {
                    "type": "planet-dignity",
                    "planet": "SELF",
                    "dignities": [
                      "EXALTED",
                      "DEEP_EXALTED"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ],
      "outcomes": [
        {
          "type": "life-class",
          "class": "long"
        }
      ]
