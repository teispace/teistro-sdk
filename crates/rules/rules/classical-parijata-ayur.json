  "rules": [
    {
      "key": "PARIJATA_MIDDLE_LIFE_WEAK_LAGNA_LORD_JUPITER_ANGULAR",
      "category": "ayur",
      "source": {
        "text": "Jataka Parijata",
        "chapter": "4",
        "verse": "84",
        "rank": 1,
        "note": "The lagna lord without strength, Jupiter in a kendra or a trikona, and a malefic in the sixth, eighth or twelfth: the middle span, from the 33rd year to the 70th. Read from V. Subrahmanya Sastri's 1932 translation."
      },
      "conditions": [
        {
          "type": "planet-weak",
          "planet": {
            "lordOf": 1
          }
        },
        {
          "type": "planet-in-house",
          "planet": "JUPITER",
          "houses": [
            1,
            4,
            5,
            7,
            9,
            10
          ]
        },
        {
          "type": "count-in-houses",
          "planets": "any-malefic",
          "houses": [
            6,
            8,
            12
          ],
          "atLeast": 1
        }
      ],
      "outcomes": [
        {
          "type": "life-class",
          "class": "medium"
        }
      ]
    },
    {
