{
  "rules": [
    {
      "key": "BPHS_TWENTY_SECOND_DECANATE_OF_A_BENEFIC",
      "category": "ayur",
      "source": {
        "text": "BPHS",
        "chapter": "44",
        "verse": "38-39",
        "rank": 1,
        "note": "A benefic's decanate as the twenty-second: the corpse is burnt in fire. The twenty-second decanate is twenty-one on from the lagna's, and twenty-one decanates are seven signs exactly, so it falls in the eighth house's sign at the third of it the lagna stands in; its own sign is that eighth counted on by one, five or nine, and its lord is that sign's lord. The benefics counted are Jupiter and Venus, the verse setting a mixed planet against them. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "or",
          "conditions": [
            {
              "type": "and",
              "conditions": [
                {
                  "type": "planet-in-degrees",
                  "planet": "LAGNA",
                  "from": 0.0,
                  "to": 10.0
                },
                {
                  "type": "or",
                  "conditions": [
                    {
                      "type": "same-body",
                      "of": {
                        "lordOf": {
                          "from": 8,
                          "house": 1
                        }
                      },
                      "as": "JUPITER"
                    },
                    {
                      "type": "same-body",
                      "of": {
                        "lordOf": {
                          "from": 8,
                          "house": 1
                        }
                      },
                      "as": "VENUS"
                    }
                  ]
                }
              ]
            },
            {
              "type": "and",
              "conditions": [
                {
                  "type": "planet-in-degrees",
                  "planet": "LAGNA",
                  "from": 10.0,
                  "to": 20.0
                },
                {
                  "type": "or",
                  "conditions": [
                    {
                      "type": "same-body",
                      "of": {
                        "lordOf": {
                          "from": 8,
                          "house": 5
                        }
                      },
                      "as": "JUPITER"
                    },
                    {
                      "type": "same-body",
                      "of": {
                        "lordOf": {
                          "from": 8,
                          "house": 5
                        }
                      },
                      "as": "VENUS"
                    }
                  ]
                }
              ]
            },
            {
              "type": "and",
              "conditions": [
                {
                  "type": "planet-in-degrees",
                  "planet": "LAGNA",
                  "from": 20.0,
                  "to": 30.0
                },
                {
                  "type": "or",
                  "conditions": [
                    {
                      "type": "same-body",
                      "of": {
                        "lordOf": {
                          "from": 8,
                          "house": 9
                        }
                      },
                      "as": "JUPITER"
                    },
                    {
                      "type": "same-body",
                      "of": {
                        "lordOf": {
                          "from": 8,
                          "house": 9
                        }
                      },
                      "as": "VENUS"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "his corpse burnt in fire, as the shastra prescribes"
        }
      ]
    },
