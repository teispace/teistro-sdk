    {
      "key": "BPHS_VENUS_IN_A_FIFTH_OF_HIS_OWN_WITH_MARS_ELEVENTH",
      "category": "dhana",
      "source": {
        "text": "BPHS",
        "chapter": "41",
        "verse": "2",
        "rank": 1,
        "note": "A sign of Venus as the fifth with Venus in it, and Mars in the eleventh, which falls for a Capricorn or a Gemini ascendant. The chapter's formula from vv. 2 to 8 is the lord of the fifth standing in the fifth while the lord of the eleventh stands in the eleventh. Read from the Maharishi Parashara Hora Shastra in R. Santhanam's translation."
      },
      "conditions": [
        {
          "type": "planet-in-house-and-sign",
          "planet": "VENUS",
          "houses": [
            5
          ],
          "signs": [
            "TAURUS",
            "LIBRA"
          ]
        },
        {
          "type": "planet-in-house",
          "planet": "MARS",
          "houses": [
            11
          ]
        }
      ],
      "outcomes": [
        {
          "type": "effect",
          "text": "very affluent"
        }
      ]
    },
