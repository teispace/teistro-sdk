{
  "words": ".input {$shape :string} .match $shape MINOR {{{$minorWords} {$minorUnit}}} BOTH {{{$majorWords} {$majorUnit} र {$minorWords} {$minorUnit}}} * {{{$majorWords} {$majorUnit}}}",
  "only": "{$amount} मात्र",
  "INR": {
    "major": ".input {$count :integer} .match $count one {{भारतीय रुपैयाँ}} * {{भारतीय रुपैयाँ}}",
    "minor": ".input {$count :integer} .match $count one {{पैसा}} * {{पैसा}}"
  },
  "NPR": {
    "major": ".input {$count :integer} .match $count one {{रुपैयाँ}} * {{रुपैयाँ}}",
    "minor": ".input {$count :integer} .match $count one {{पैसा}} * {{पैसा}}"
  }
}
