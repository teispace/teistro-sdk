{
  "locale": "en-Latn-NP",
  "direction": "ltr",
  "numberingSystem": "latn",
  "grouping": [3, 2],
  "decimal": ".",
  "group": ",",
  "fallback": ["en-Latn"],
  "completeness": "base",
  "contexts": {
    "gender": ["m", "f", "n"]
  },
  "termStyle": "vernacular",
  "listPatterns": {
    "and": { "pair": "{0} and {1}", "middle": "{0}, {1}", "end": "{0} and {1}" },
    "or": { "pair": "{0} or {1}", "middle": "{0}, {1}", "end": "{0} or {1}" },
    "unit": { "pair": "{0}, {1}", "middle": "{0}, {1}", "end": "{0}, {1}" }
  }
}
